<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#if title}}{{title}} | {{/if}}Catálogo de Oficinas</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
  </head>
  <body class="bg-body-tertiary">
    <div class="container py-3">
      <ul class="nav nav-pills nav-justified bg-dark rounded-3 shadow-sm p-1 mb-3">
        <li class="nav-item">
          <a class="nav-link {{#if menuInicio}}active bg-success{{else}}link-light{{/if}}" {{#if menuInicio}}aria-current="page"{{/if}} href="/">Início</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if menuSobre}}active bg-info text-dark{{else}}link-light{{/if}}" {{#if menuSobre}}aria-current="page"{{/if}} href="/sobre">Sobre</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if menuNova}}active bg-warning text-dark{{else}}link-light{{/if}}" {{#if menuNova}}aria-current="page"{{/if}} href="/oficinas/nova">Nova Oficina</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if menuPesquisa}}active bg-primary{{else}}link-light{{/if}}" {{#if menuPesquisa}}aria-current="page"{{/if}} href="/oficinas/pesquisa">Pesquisa</a>
        </li>
      </ul>

      <main class="bg-body rounded-3 shadow-sm p-3 p-md-4">
        {{{body}}}
      </main>
    </div>

    <script src="/javascripts/bootstrap.bundle.min.js"></script>
  </body>
</html>
